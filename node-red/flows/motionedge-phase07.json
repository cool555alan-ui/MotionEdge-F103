  {"id":"p7commandfn0001","type":"function","z":"p7tab00000000001","name":"Build UUID command","func":"const allowed=['ping','get_status','get_config','start_calibration','set_stream_state','actuator_status','actuator_arm','actuator_disarm','actuator_center','actuator_set_target','actuator_estop','control_status','control_enable','control_disable','control_zero','control_set_axis','control_set_direction','control_get_pid','control_set_pid','control_set_deadband','config_persist_status','config_persist_save','config_persist_load','config_factory_reset'];const b=msg.payload||{};if(!allowed.includes(b.command)){msg.statusCode=400;msg.payload={error:'COMMAND_NOT_ALLOWED'};return [null,msg];}const id='xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g,c=>{const r=Math.random()*16|0,v=c==='x'?r:(r&3|8);return v.toString(16)});const now=new Date(),expires=new Date(now.getTime()+30000);const command={schema_version:1,request_id:id,command:b.command,issued_at:now.toISOString(),expires_at:expires.toISOString(),params:b.params||{}};let m=flow.get('p7metrics')||{};m.command_sent=(m.command_sent||0)+1;flow.set('p7metrics',m);const mqtt={payload:JSON.stringify(command),topic:'motionedge/v1/devices/motionedge-f103-01/command',qos:1,retain:false};msg.statusCode=202;msg.payload={accepted:true,request_id:id};return [mqtt,msg];","outputs":2,"x":470,"y":520,"wires":[["p7commandmqtt01"],["p7httpresponse1"]]},
