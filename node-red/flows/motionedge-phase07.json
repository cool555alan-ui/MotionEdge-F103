  {"id":"p7process0000001","type":"function","z":"p7tab00000000001","name":"Validate, bounded metrics and WebSocket","func":"let data=msg.payload;if(data===null||data===''||(Buffer.isBuffer(data)&&data.length===0))return null;try{if(typeof data==='string'||Buffer.isBuffer(data))data=JSON.parse(data.toString());}catch(e){let m=flow.get('p7metrics')||{};m.invalid_json=(m.invalid_json||0)+1;flow.set('p7metrics',m);return null;}if(!data||data.schema_version!==1){let m=flow.get('p7metrics')||{};m.schema_error=(m.schema_error||0)+1;flow.set('p7metrics',m);return null;}let m=flow.get('p7metrics')||{motion_received:0,health_received:0,actuator_received:0,control_received:0,duplicate_received:0,invalid_json:0,schema_error:0,sequence_gap:0,command_sent:0,command_success:0,command_timeout:0,latencies:[]};let kind='state';if(msg.topic.includes('/telemetry/motion')){kind='motion';m.motion_received++;if(m.motion_received>5&&m.last_sequence!==undefined){const d=data.sequence-m.last_sequence;if(d===0)m.duplicate_received++;else if(d<0)m.sequence_regression=(m.sequence_regression||0)+1;else if(d!==10)m.sequence_gap++;}m.last_sequence=data.sequence;m.last_motion_unix_ms=Date.now();if(data.gateway_published_unix_ms){if(!m.latencies)m.latencies=[];m.latencies.push(Date.now()-data.gateway_published_unix_ms);if(m.latencies.length>1000)m.latencies.shift();}}else if(msg.topic.includes('/telemetry/health')){kind='health';m.health_received++;}else if(msg.topic.includes('/telemetry/actuator')){kind='actuator';m.actuator_received++;}else if(msg.topic.includes('/telemetry/control')){kind='control';m.control_received++;}else if(msg.topic.endsWith('/response')){kind='response';if(data.ok)m.command_success++;}else if(msg.topic.includes('/metrics'))kind='gateway_metrics';else if(msg.topic.endsWith('/meta'))kind='meta';flow.set('p7metrics',m);flow.set('p7status',{kind:kind,data:data,received_at:new Date().toISOString()});msg.payload=JSON.stringify({kind:kind,data:data});return msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":470,"y":190,"wires":[["p7wsout00000001"]]},
